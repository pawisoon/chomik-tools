# Copy to .env (gitignored) and fill in. Used by the live tests and later by
# chomik-cloner / chomik-mcp. Per account give PASSWORD or PASSWORD_HASH
# (md5 hex of the password, what the API actually sends).

# Account A: source (e.g. your main chomik)
CHOMIK_A_USER=
CHOMIK_A_PASSWORD=
CHOMIK_A_PASSWORD_HASH=

# Account B: destination (clone target)
CHOMIK_B_USER=
CHOMIK_B_PASSWORD=
CHOMIK_B_PASSWORD_HASH=

# Profile (access) password of your own chomik, if it has one. Needed when the
# OTHER account must see it (e.g. B copying from A). Folder passwords and other
# people's chomiki go in chomik-passwords.json (template: chomik-passwords.example.json).
CHOMIK_A_PROFILE_PASSWORD=
CHOMIK_B_PROFILE_PASSWORD=
