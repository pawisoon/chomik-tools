# Password for the settings panel at http://<host>:8765/ (required)
PANEL_PASSWORD=

# Accounts can be entered in the panel instead of here.
# Accounts: one letter per account. Add C, D, ... the same way.
CHOMIK_A_USER=
CHOMIK_A_PASSWORD=
# CHOMIK_A_PROFILE_PASSWORD=

CHOMIK_B_USER=
CHOMIK_B_PASSWORD=
# CHOMIK_B_PROFILE_PASSWORD=

# Extra accounts that must never lose data (A is always protected)
# CHOMIK_PROTECTED_USERS=

# Optional: fixed MCP token (otherwise the panel creates one)
# MCP_TOKEN=
# MCP_PORT=8765
# MCP_ALLOWED_HOSTS=nas.local:8765,192.168.1.10:8765
